@startuml c4_codigo
!include ../../commons/plantuml_config.puml

title Diagrama C4 - Nivel 4: Código (Servicio Autenticación)

package "auth" {
    class AuthService {
        +register_user(data)
        +login_user(credentials)
        +verify_token(token)
    }
    
    class TokenManager {
        +generate_token(user_id)
        +validate_token(token)
    }
    
    class PasswordHasher {
        +hash_password(password)
        +verify_password(password, hash)
    }
}

AuthService ..> TokenManager
AuthService ..> PasswordHasher

@enduml

