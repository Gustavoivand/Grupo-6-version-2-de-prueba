@startuml robustez_uc01
!include ../../commons/plantuml_config.puml

title Diagrama de Robustez - UC01: Registrar Usuario

actor Usuario
boundary "Formulario\nRegistro" as Form
control "Controlador\nRegistro" as Controller
entity "Base de Datos" as DB

Usuario -> Form : Ingresa datos
Form -> Controller : Valida datos
Controller -> DB : Crea usuario
DB -> Controller : Confirma
Controller -> Form : Muestra éxito
Form -> Usuario : Redirige a login

@enduml

