@startuml secuencia_analisis_uc01
!include ../../commons/plantuml_config.puml

title Diagrama de Secuencia de Análisis - UC01: Registrar Usuario

actor Usuario
boundary FormularioRegistro
control ControladorRegistro
entity BaseDatos

Usuario -> FormularioRegistro : Ingresa datos
activate FormularioRegistro

FormularioRegistro -> ControladorRegistro : validar_datos(email, password)
activate ControladorRegistro

ControladorRegistro -> BaseDatos : verificar_email_existe(email)
activate BaseDatos
BaseDatos --> ControladorRegistro : false
deactivate BaseDatos

ControladorRegistro -> BaseDatos : crear_usuario(datos)
activate BaseDatos
BaseDatos --> ControladorRegistro : usuario_creado
deactivate BaseDatos

ControladorRegistro --> FormularioRegistro : registro_exitoso
deactivate ControladorRegistro

FormularioRegistro --> Usuario : Mostrar confirmación
deactivate FormularioRegistro

@enduml

