@startuml despliegue
!include ../../commons/plantuml_config.puml

title Diagrama de Despliegue - BookMate con Docker

node "Host Machine" {
    node "Docker Engine" {
        node "<<Container>>\nweb:5000" as web {
            artifact "Flask App" as flask
            artifact "Gunicorn" as gunicorn
        }
        
        node "<<Container>>\ndb:5432" as db {
            database "PostgreSQL" as postgres
        }
        
        node "<<Container>>\nai_service:5001" as ai {
            artifact "Flask AI" as flask_ai
            artifact "ML Models" as models
        }
    }
}

node "User Browser" as browser

browser --> web : HTTPS:5000
web --> db : TCP:5432
web --> ai : HTTP:5001

@enduml

