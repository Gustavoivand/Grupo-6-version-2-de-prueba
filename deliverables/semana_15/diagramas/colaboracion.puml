@startuml colaboracion
!include ../../commons/plantuml_config.puml

title Diagrama de Colaboración - Obtener Recomendaciones

object ":Usuario" as user
object ":APIRoute" as route
object ":RecService" as service
object ":Heuristic" as heuristic
object ":Database" as db

user --> route : 1: GET /recommendations
route --> service : 2: get_recommendations()
service --> db : 3: get_user_books()
db --> service : 4: user_books[]
service --> heuristic : 5: calculate(user_books)
heuristic --> db : 6: get_all_books()
db --> heuristic : 7: books[]
heuristic --> service : 8: scored_books[]
service --> route : 9: recommendations[]
route --> user : 10: JSON response

@enduml

