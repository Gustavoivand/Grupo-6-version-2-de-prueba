@startuml componentes
!include ../../commons/plantuml_config.puml

title Diagrama de Componentes - Sistema BookMate

package "Web Layer" {
    component [API Routes] as routes
    component [Middleware] as middleware
}

package "Business Layer" {
    component [Auth Service] as auth
    component [Library Service] as library
    component [Recommendation Service] as recommend
    component [Search Service] as search
}

package "Data Layer" {
    component [User Repository] as user_repo
    component [Book Repository] as book_repo
    component [Library Repository] as lib_repo
}

package "AI Layer" {
    component [Heuristic Engine] as heuristic
    component [AI Engine] as ai
}

database "PostgreSQL" as db

routes --> middleware
middleware --> auth
middleware --> library
middleware --> recommend
middleware --> search

auth --> user_repo
library --> lib_repo
recommend --> heuristic
recommend --> ai
search --> book_repo

user_repo --> db
book_repo --> db
lib_repo --> db

@enduml

