@startuml uc_registrar_usuario
!include ../../commons/plantuml_config.puml

left to right direction
title Caso de Uso: UC01 - Registrar Usuario

actor "Usuario No Registrado" as User

rectangle "Sistema BookMate" {
    usecase "UC01: Registrar Usuario" as UC01
    usecase "Validar Email" as Val1
    usecase "Validar Contraseña" as Val2
    usecase "Enviar Email Confirmación" as Email
}

User --> UC01
UC01 ..> Val1 : <<include>>
UC01 ..> Val2 : <<include>>
UC01 ..> Email : <<extend>>

note right of UC01
  **Precondiciones:**
  - Email no registrado
  **Postcondiciones:**
  - Usuario creado en BD
  - Email de confirmación enviado
end note

@enduml

