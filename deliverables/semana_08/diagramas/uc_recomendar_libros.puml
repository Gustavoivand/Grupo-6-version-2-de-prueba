@startuml uc_recomendar_libros
!include ../../commons/plantuml_config.puml

left to right direction
title Caso de Uso: UC13 - Obtener Recomendaciones

actor "Usuario Autenticado" as User

rectangle "Sistema BookMate" {
    usecase "UC13: Obtener Recomendaciones" as UC13
    usecase "Analizar Biblioteca" as Analyze
    usecase "Aplicar Heurística" as Heuristic
    usecase "Aplicar IA" as AI
    usecase "Autenticar Usuario" as Auth
}

User --> UC13
UC13 ..> Auth : <<include>>
UC13 ..> Analyze : <<include>>
UC13 ..> Heuristic : <<extend>>
UC13 ..> AI : <<extend>>

note right of UC13
  **Algoritmos:**
  - Heurístico (Fase 1)
  - IA con embeddings (Fase 2)
end note

@enduml

