@startuml casos_uso_bookmate
' ============================================================================
' DIAGRAMA DE CASOS DE USO - BOOKMATE
' Proyecto: Sistema de Recomendación de Libros Académicos
' Grupo: 6
' Universidad: UNI
' ============================================================================

title Casos de Uso - Sistema BookMate

' Definición de actores
left to right direction

actor "Usuario" as Usuario
actor "Administrador" as Admin
actor "Sistema IA" as IA

' El Administrador hereda de Usuario
Admin --|> Usuario

' Definición del sistema
rectangle "Sistema BookMate" {
  
  ' Casos de uso de gestión de libros (Admin)
  package "Gestión de Catálogo" {
    usecase "UC-01\nCrear Libro" as UC01
    usecase "UC-02\nListar Libros" as UC02
    usecase "UC-03\nActualizar Libro" as UC03
    usecase "UC-04\nEliminar Libro" as UC04
    usecase "UC-10\nCrear Autor" as UC10
    usecase "UC-11\nListar Autores" as UC11
    usecase "UC-12\nActualizar Autor" as UC12
    usecase "UC-13\nEliminar Autor" as UC13
  }
  
  ' Casos de uso de búsqueda y exploración (Usuario)
  package "Búsqueda y Exploración" {
    usecase "UC-05\nBuscar Libros" as UC05
    usecase "UC-07\nVer Detalle\nde Libro" as UC07
    usecase "UC-08\nFiltrar por Precio" as UC08
    usecase "UC-09\nNavegar Catálogo" as UC09
  }
  
  ' Caso de uso más importante: Recomendaciones
  package "Recomendaciones" {
    usecase "UC-06\nObtener\nRecomendaciones" as UC06 #LightYellow
    note right of UC06
      **Caso de uso crítico**
      Prioridad: Muy Alta
      Utiliza IA para análisis
      semántico de sinopsis
    end note
  }
  
  ' Casos de uso de importación/exportación (Admin)
  package "Gestión de Datos" {
    usecase "UC-14\nImportar desde CSV" as UC14
    usecase "UC-15\nExportar a CSV" as UC15
  }
}

' Relaciones Usuario - Casos de Uso
Usuario --> UC02
Usuario --> UC05
Usuario --> UC06
Usuario --> UC07
Usuario --> UC08
Usuario --> UC09

' Relaciones Admin - Casos de Uso (solo los exclusivos de admin)
Admin --> UC01
Admin --> UC03
Admin --> UC04
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15

' Relación con Sistema IA
UC06 ..> IA : << comunica >>

' Relaciones include y extend
UC01 .> UC10 : << include >>
note on link
  Crear libro requiere
  que exista un autor
end note

UC03 .> UC02 : << include >>
UC04 .> UC02 : << include >>

@enduml

@startuml casos_uso_detallados
' ============================================================================
' DIAGRAMA DE CASOS DE USO DETALLADO - UC-06 RECOMENDACIONES
' ============================================================================

title Caso de Uso Detallado: UC-06 Obtener Recomendaciones

actor "Usuario" as Usuario
actor "Sistema IA" as IA

rectangle "Sistema BookMate" {
  usecase "UC-06\nObtener\nRecomendaciones" as UC06 #LightYellow
  usecase "Generar\nRecomendaciones\ncon IA" as RecIA
  usecase "Generar\nRecomendaciones\nHeurísticas" as RecHeur
  usecase "Consultar\nDetalles de\nLibros" as Detalles
  usecase "Calcular\nSimilitud\nSemántica" as Similitud
}

Usuario --> UC06

UC06 .> RecIA : << include >>
UC06 .> RecHeur : << extend >>\n[IA no disponible]
UC06 .> Detalles : << include >>

RecIA ..> IA : << comunica >>
RecIA .> Similitud : << include >>

note right of RecIA
  **Flujo principal**
  1. Obtener sinopsis del libro
  2. Enviar a Servicio IA
  3. IA genera embeddings
  4. IA calcula similitud de coseno
  5. Retornar top 6 libros
end note

note right of RecHeur
  **Flujo alternativo (fallback)**
  1. Aplicar reglas heurísticas:
     - Género compartido
     - Autor común
     - Tags similares
     - Precio similar
  2. Calcular puntuación
  3. Retornar top 6 libros
end note

@enduml

@startuml casos_uso_gestion_libros
' ============================================================================
' DIAGRAMA DE CASOS DE USO - GESTIÓN DE LIBROS
' ============================================================================

title Casos de Uso: Gestión de Libros (CRUD)

actor "Administrador" as Admin

rectangle "Sistema BookMate" {
  usecase "UC-01\nCrear Libro" as UC01
  usecase "UC-02\nListar Libros" as UC02
  usecase "UC-03\nActualizar Libro" as UC03
  usecase "UC-04\nEliminar Libro" as UC04
  
  usecase "Validar Datos\nde Entrada" as Validar
  usecase "Persistir en\nBase de Datos" as Persistir
  usecase "Generar/Actualizar\nEmbedding" as Embedding
}

actor "Sistema IA" as IA

Admin --> UC01
Admin --> UC02
Admin --> UC03
Admin --> UC04

UC01 .> Validar : << include >>
UC01 .> Persistir : << include >>
UC01 .> Embedding : << include >>

UC03 .> Validar : << include >>
UC03 .> Persistir : << include >>
UC03 .> Embedding : << extend >>\n[sinopsis cambió]

UC04 .> Persistir : << include >>

Embedding ..> IA : << comunica >>

@enduml

@startuml casos_uso_busqueda
' ============================================================================
' DIAGRAMA DE CASOS DE USO - BÚSQUEDA Y FILTRADO
' ============================================================================

title Casos de Uso: Búsqueda y Exploración

actor "Usuario" as Usuario

rectangle "Sistema BookMate" {
  usecase "UC-05\nBuscar Libros" as UC05
  usecase "UC-08\nFiltrar por Precio" as UC08
  usecase "UC-09\nNavegar Catálogo" as UC09
  usecase "UC-07\nVer Detalle\nde Libro" as UC07
  
  usecase "Aplicar Filtros" as Filtros
  usecase "Ordenar\nResultados" as Ordenar
  usecase "Paginar\nResultados" as Paginar
}

Usuario --> UC05
Usuario --> UC08
Usuario --> UC09
Usuario --> UC07

UC05 .> Filtros : << extend >>\n[filtros seleccionados]
UC05 .> Ordenar : << include >>

UC08 .> Filtros : << include >>
UC08 .> Ordenar : << include >>

UC09 .> Paginar : << include >>
UC09 .> Ordenar : << extend >>\n[ordenamiento seleccionado]

note right of UC05
  **Criterios de búsqueda:**
  - Título
  - Autor
  - Género
  - Combinación
  
  **Tiempo de respuesta:**
  <1 segundo (p95)
end note

